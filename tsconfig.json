{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "lib": ["es2023", "dom"]
  },
  "include": [
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "apps/*/src/**/*.ts",
    "apps/*/src/**/*.tsx",
    "*.config.ts",
    "apps/*/*.config.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist",
    "apps/cuaderno/src/sw.ts",
    "apps/parqueadero-sitio/src/caja/sw.ts"
  ]
}
