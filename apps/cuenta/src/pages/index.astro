---
/**
 * La portada de la cuenta (HU-C7.2, HU-C7.3). Sin sesión: el formulario para entrar con Google, que
 * pide aceptar la política de la cuenta y funciona aun sin JavaScript (un GET al CORE, en el mismo
 * origen). Con sesión: quién entró, volver a la app de la que se vino y salir.
 *
 * Las apps a las que se puede volver salen del registro de productos (P2): solo esos orígenes.
 */
import { Aviso, Boton } from '@ed1/ui/v2/componentes';
import politica from '../../../../content/cuenta/privacidad/politica.json';
import celdas from '../../../../infrastructure/celdas.json';
import registro from '../../../../infrastructure/productos.json';
import Base from '../layouts/Base.astro';

const apps = registro.productos
  .filter((p) => p.organizaciones !== false && p.estado === 'activo')
  .map((p) => ({
    nombre: p.nombre,
    origenes:
      p.app.origenes === 'celdas.json › sitio'
        ? [`https://${celdas.sitio.dominio}`, celdas.sitio.url_staging]
        : [p.app.origenes.produccion, p.app.origenes.staging],
  }));

const bloques = [
  {
    id: 'sesiones',
    titulo: 'Dónde has entrado',
    ayuda: 'Si perdiste un teléfono o entraste en un equipo prestado, cierra aquí esa sesión.',
    vacio: 'No tienes otras sesiones abiertas.',
  },
  {
    id: 'pagos',
    titulo: 'Tus pagos',
    ayuda: 'Lo que se ha pagado en los espacios que administras, y hasta cuándo cubre.',
    vacio: 'Todavía no hay pagos en los espacios que administras.',
  },
  {
    id: 'asistentes',
    titulo: 'Asistentes con acceso',
    ayuda:
      'Los asistentes, como Claude o ChatGPT, a los que les diste permiso sobre tus espacios. Quita el acceso cuando quieras: deja de servir de inmediato.',
    vacio: 'Ningún asistente tiene acceso a tus espacios.',
  },
  {
    id: 'actividad',
    titulo: 'Lo que pasó en tus espacios',
    ayuda: 'Quién entró, se unió, cambió de rol o pagó, en los espacios que administras.',
    vacio: 'Todavía no ha pasado nada que mostrar.',
  },
  {
    id: 'datos',
    titulo: 'Tus datos',
    ayuda:
      'Descarga lo que guardamos de ti, o pídenos consultarlo, corregirlo o borrarlo. Cada solicitud tiene un número y una fecha límite para responderte, como dice la ley.',
    vacio: 'Todavía no has hecho solicitudes sobre tus datos.',
  },
] as const;
---
<Base
  titulo="Laboratorio Digital"
  descripcion="Tu cuenta de Laboratorio Digital: tus aplicaciones, tus sesiones y tus pagos en un solo lugar."
>
  <main class="portada" data-apps={JSON.stringify(apps)}>
    <h1 class="portada__titulo">Tu cuenta, en un solo lugar.</h1>
    <p class="portada__texto">
      Aquí vas a ver las aplicaciones que usas con tu cuenta, desde qué equipos entraste y lo que
      has pagado. Todo lo tuyo, sin tener que buscarlo en cada aplicación.
    </p>

    <div class="portada__aviso" data-error hidden>
      <Aviso tono="peligro" titulo="Algo no salió bien">
        <p data-error-texto>No pudimos completar la entrada. Intenta de nuevo.</p>
      </Aviso>
    </div>

    <section class="portada__accion" data-sin-sesion>
      <p class="portada__nota" data-vuelve-aviso hidden>
        Después de entrar puedes volver a <strong data-vuelve-nombre></strong>.
      </p>
      <form class="portada__formulario" method="get" action="/api/core/auth/google/inicio">
        <input type="hidden" name="producto" value="cuenta" />
        <input type="hidden" name="politica" value={politica.version} />
        <input type="hidden" name="vuelta" value="https://cuenta.laboratorio-digital.com/" data-vuelta />
        <label class="portada__acepto">
          <input type="checkbox" name="acepto" value="si" required />
          <span>Leí y acepto la <a href="/privacidad/">política de tratamiento de datos</a>.</span>
        </label>
        <Boton tipo="submit">Entrar con Google</Boton>
      </form>
    </section>

    <section class="portada__accion" data-con-sesion hidden>
      <p class="portada__nota">Entraste como <strong data-nombre></strong>.</p>
      <div class="portada__botones">
        <a class="ed1-boton ed1-boton--primario" data-vuelve-enlace hidden href="/">Volver</a>
        <button class="ed1-boton ed1-boton--secundario" type="button" data-salir>Salir</button>
      </div>
    </section>

    <section class="portada__espacios" data-con-sesion hidden aria-labelledby="titulo-espacios">
      <h2 class="portada__subtitulo" id="titulo-espacios">Tus espacios</h2>
      <p class="ed1-contenido ed1-contenido--cargando" role="status" data-espacios-cargando>
        Cargando tus espacios…
      </p>
      <div class="ed1-contenido ed1-contenido--vacio" data-espacios-vacio hidden>
        <p>
          Todavía no tienes espacios en nuestras aplicaciones. Cuando crees uno, o alguien te
          invite al suyo, aparece aquí.
        </p>
        <a class="ed1-boton ed1-boton--secundario" href="https://cultivopro.co/agro/app/">
          Conocer CultivoPro
        </a>
      </div>
      <div class="ed1-contenido ed1-contenido--error" role="alert" data-espacios-error hidden>
        <p data-espacios-causa>No pudimos traer tus espacios.</p>
        <button class="ed1-boton ed1-boton--secundario" type="button" data-espacios-reintentar>
          Intentar de nuevo
        </button>
      </div>
      <ul class="portada__lista" aria-labelledby="titulo-espacios" data-espacios-lista hidden></ul>
    </section>

    {
      /* HU-C7.5 a HU-C7.8: cada bloque se llena desde sesion.ts con su ruta del CORE. */
      bloques.map((b) => (
        <section
          class="portada__espacios"
          data-con-sesion
          hidden
          data-bloque={b.id}
          aria-labelledby={`titulo-${b.id}`}
        >
          <h2 class="portada__subtitulo" id={`titulo-${b.id}`}>{b.titulo}</h2>
          <p class="portada__detalle">{b.ayuda}</p>
          {b.id === 'datos' && (
            <div class="portada__datos">
              <div class="portada__descarga">
                <button class="ed1-boton ed1-boton--secundario" type="button" data-descargar>
                  Descargar mis datos
                </button>
                <p class="portada__detalle" role="status" data-descarga-estado />
              </div>
              <form class="portada__radicar" data-radicar novalidate>
                <h3 class="portada__subtitulo-menor">Hacer una solicitud</h3>
                <div class="ed1-campo">
                  <label class="ed1-campo__etiqueta" for="radicar-tipo">Qué necesitas</label>
                  <select class="ed1-campo__control" id="radicar-tipo" name="tipo">
                    <option value="consulta">Saber qué datos míos tienen (consulta)</option>
                    <option value="reclamo">Corregir mis datos o hacer un reclamo</option>
                    <option value="supresion">Que borren mis datos (supresión)</option>
                  </select>
                </div>
                <div class="ed1-campo" data-campo-texto>
                  <label class="ed1-campo__etiqueta" for="radicar-texto">Cuéntanos</label>
                  <textarea
                    class="ed1-campo__control portada__texto-largo"
                    id="radicar-texto"
                    name="texto"
                    rows="4"
                    maxlength="2000"
                    aria-describedby="radicar-texto-ayuda"
                  />
                  <p class="ed1-campo__ayuda" id="radicar-texto-ayuda">
                    Entre 10 y 2.000 caracteres. Lo lee una persona.
                  </p>
                  <p class="ed1-campo__error" id="radicar-texto-error" data-radicar-error hidden />
                </div>
                <button class="ed1-boton ed1-boton--primario" type="submit">Enviar solicitud</button>
                <div class="portada__radicado" role="status" data-radicado hidden>
                  <p data-radicado-texto />
                </div>
              </form>
              <h3 class="portada__subtitulo-menor">Tus solicitudes</h3>
            </div>
          )}
          <p class="ed1-contenido ed1-contenido--cargando" role="status" data-estado="cargando">
            Cargando…
          </p>
          <p class="ed1-contenido ed1-contenido--vacio" data-estado="vacio" hidden>
            {b.vacio}
          </p>
          <div class="ed1-contenido ed1-contenido--error" role="alert" data-estado="error" hidden>
            <p data-causa>No pudimos traer esto.</p>
            <button class="ed1-boton ed1-boton--secundario" type="button" data-reintentar>
              Intentar de nuevo
            </button>
          </div>
          {b.id === 'sesiones' && (
            <div class="portada__reentrar" role="alert" data-reentrar hidden>
              <p data-reentrar-texto>
                Para cerrar sesiones, vuelve a entrar con Google. Así sabemos que eres tú.
              </p>
              <button class="ed1-boton ed1-boton--primario" type="button" data-reentrar-boton>
                Entrar de nuevo
              </button>
            </div>
          )}
          <ul class="ed1-lista" data-estado="lista" hidden />
          {b.id === 'sesiones' && (
            <button class="ed1-boton ed1-boton--secundario" type="button" data-cerrar-todas hidden>
              Cerrar todas menos esta
            </button>
          )}
        </section>
      ))
    }
  </main>
</Base>

<script>
  import '../sesion.ts';
</script>
