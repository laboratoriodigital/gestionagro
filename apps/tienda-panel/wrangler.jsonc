// GENERADO por scripts/generar-wrangler.ts desde infrastructure/celdas.json. No editar a mano.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tienda-panel",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/mcp",
      "/.well-known/*"
    ],
    "not_found_handling": "single-page-application"
  },
  "workers_dev": false,
  "routes": [
    {
      "pattern": "panel.laboratorio-digital.app",
      "custom_domain": true
    },
    {
      "pattern": "mcp.laboratorio-digital.app",
      "custom_domain": true
    }
  ],
  "services": [
    {
      "binding": "API_C1",
      "service": "tienda-api-c1"
    }
  ],
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "tienda-panel-staging",
      "workers_dev": true,
      "routes": [],
      "services": [
        {
          "binding": "API_C1",
          "service": "tienda-api-c1-staging"
        }
      ]
    }
  }
}
