// GENERADO por scripts/generar-wrangler.ts desde infrastructure/celdas.json. No editar a mano.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agro-api-c0",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "vars": {
    "CELDA": "c0"
  },
  "d1_databases": [
    {
      "binding": "agro_c0_s1",
      "database_name": "agro_c0_s1",
      "migrations_dir": "../../infrastructure/migraciones/celda"
    }
  ],
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "agro-api-c0-staging",
      "workers_dev": true,
      "vars": {
        "CELDA": "c0"
      },
      "d1_databases": [
        {
          "binding": "agro_c0_s1",
          "database_name": "agro_c0_s1_staging",
          "migrations_dir": "../../infrastructure/migraciones/celda"
        }
      ]
    }
  }
}
