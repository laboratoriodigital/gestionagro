// GENERADO por scripts/generar-wrangler.ts desde infrastructure/celdas.json. No editar a mano.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agro-api-c0",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "vars": {
    "CELDA": "c0",
    "PRODUCTO": "agro",
    "PLAN": "free",
    "PRESUPUESTO_USD_MES": "11",
    "AL_AGOTARSE": "",
    "FILAS_D1_POR_PRODUCTO": "{\"parqueadero\":70000}"
  },
  "d1_databases": [
    {
      "binding": "agro_c0_s1",
      "database_name": "agro_c0_s1",
      "migrations_dir": "../../infrastructure/migraciones/celda"
    }
  ],
  "services": [
    {
      "binding": "CORE",
      "service": "agro-core",
      "entrypoint": "ServicioDelCore"
    }
  ],
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "agro-api-c0-staging",
      "workers_dev": true,
      "vars": {
        "CELDA": "c0",
        "PRODUCTO": "agro",
        "PLAN": "free",
        "PRESUPUESTO_USD_MES": "11",
        "AL_AGOTARSE": "",
        "FILAS_D1_POR_PRODUCTO": "{\"parqueadero\":70000}"
      },
      "d1_databases": [
        {
          "binding": "agro_c0_s1",
          "database_name": "agro_c0_s1_staging",
          "migrations_dir": "../../infrastructure/migraciones/celda"
        }
      ],
      "services": [
        {
          "binding": "CORE",
          "service": "agro-core-staging",
          "entrypoint": "ServicioDelCore"
        }
      ],
      "triggers": {
        "crons": [
          "0 * * * *"
        ]
      }
    }
  }
}
