// GENERADO por scripts/generar-wrangler.ts desde infrastructure/celdas.json. No editar a mano.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agro-core",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "../cuenta/dist",
    "run_worker_first": [
      "/api/core/*",
      "/oauth/*",
      "/.well-known/*"
    ],
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "cuenta.laboratorio-digital.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agro_core",
      "migrations_dir": "../../infrastructure/migraciones/core"
    }
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "ratelimits": [
    {
      "name": "LIMITE_CORREO",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "agro-core-staging",
      "workers_dev": true,
      "routes": [],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "agro_core_staging",
          "migrations_dir": "../../infrastructure/migraciones/core"
        }
      ],
      "triggers": {
        "crons": [
          "*/15 * * * *"
        ]
      },
      "ratelimits": [
        {
          "name": "LIMITE_CORREO",
          "namespace_id": "1101",
          "simple": {
            "limit": 5,
            "period": 60
          }
        }
      ]
    }
  }
}
