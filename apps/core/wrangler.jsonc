// GENERADO por scripts/generar-wrangler.ts desde infrastructure/celdas.json. No editar a mano.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agro-core",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agro_core",
      "migrations_dir": "../../infrastructure/migraciones/core"
    }
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "agro-core-staging",
      "workers_dev": true,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "agro_core_staging",
          "migrations_dir": "../../infrastructure/migraciones/core"
        }
      ],
      "triggers": {
        "crons": [
          "*/15 * * * *"
        ]
      }
    }
  }
}
