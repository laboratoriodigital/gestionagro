---
/**
 * Página de cada herramienta, generada desde su `product.yaml` (HU-E1.6).
 * El contenido completo se ve sin JavaScript (P20); la calculadora llega como isla (HU-E2.2).
 */
import type { Producto } from '../../../../../../scripts/lib/productos.ts';
import CalculadoraDpv from '../../../islas/CalculadoraDpv.tsx';
import Base from '../../../layouts/Base.astro';
import { contenidoDe, herramientas, paginaDe, productoPorId } from '../../../lib/contenido.ts';
import { jsonLdDeHerramienta, segmentoDe, seoDeProducto } from '../../../lib/seo.ts';

export function getStaticPaths() {
  return herramientas.map((h) => ({
    params: { herramienta: segmentoDe(h) },
    props: { producto: h },
  }));
}

interface Props {
  producto: Producto;
}

const { producto } = Astro.props;
const seo = seoDeProducto(producto);
const secciones = contenidoDe(producto.carpeta);
const pagina = paginaDe(producto.carpeta);
const relacionados = producto.relacionados
  .map(productoPorId)
  .filter((p): p is Producto => p !== undefined);
---
<Base
  title={seo.title}
  description={seo.description}
  canonical={seo.canonical}
  indexable={seo.indexable}
  og={seo.og}
  migas={seo.migas}
  jsonLd={jsonLdDeHerramienta(producto, pagina)}
>
  <article data-producto={producto.id}>
    <h1>{producto.nombre}</h1>
    <p class="entrada">{producto.seo.description}</p>

    <section aria-labelledby="titulo-calculadora" class="calculadora">
      <h2 id="titulo-calculadora">Calcular</h2>
      {
        producto.id === 'agro-calculadora-dpv' ? (
          <>
            <CalculadoraDpv client:load />
            <noscript>
              <p>La calculadora necesita JavaScript. Abajo está el cálculo paso a paso para hacerlo a mano.</p>
            </noscript>
            <p class="privacidad">Los valores no salen de tu teléfono: el cálculo se hace aquí.</p>
          </>
        ) : (
          <p>La calculadora llega con la próxima versión.</p>
        )
      }
    </section>

    {secciones.map((s) => <s.Content />)}

    {
      pagina && pagina.preguntas.length > 0 && (
        <section aria-labelledby="titulo-preguntas" class="preguntas">
          <h2 id="titulo-preguntas">Preguntas frecuentes</h2>
          {pagina.preguntas.map((q) => (
            <details>
              <summary>{q.pregunta}</summary>
              <p>{q.respuesta}</p>
            </details>
          ))}
        </section>
      )
    }

    {
      producto.fuentes.length > 0 && (
        <section aria-labelledby="titulo-fuentes">
          <h2 id="titulo-fuentes">Fuentes</h2>
          <ul>
            {producto.fuentes.map((f) => (
              <li>{f}</li>
            ))}
          </ul>
        </section>
      )
    }

    {
      relacionados.length > 0 && (
        <nav aria-labelledby="titulo-relacionados">
          <h2 id="titulo-relacionados">Sigue con</h2>
          <ul>
            {relacionados.map((r) => (
              <li>
                <a href={r.slug}>{r.nombre}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </article>
</Base>

<script>
  import { crearColector, entornoDelNavegador } from '@gestionagro/eventos';

  const articulo = document.querySelector<HTMLElement>('[data-producto]');
  const producto = articulo?.dataset['producto'];
  if (producto) {
    const colector = crearColector({ producto, entorno: entornoDelNavegador() });
    colector.registrar('tool.opened');
    // La isla de la calculadora (HU-E2.2) registra tool.completed, tool.shared y tool.next_step aquí.
    Object.assign(window, { agroEventos: colector });
  }
</script>

<style is:global>
  .calculadora-dpv .campo {
    margin-block-end: var(--espacio-3);
  }
  .calculadora-dpv label,
  .calculadora-dpv summary {
    display: block;
    font-weight: 600;
    margin-block-end: var(--espacio-1);
  }
  .calculadora-dpv summary {
    min-height: var(--objetivo-tactil);
    display: flex;
    align-items: center;
    cursor: pointer;
  }
  .calculadora-dpv .unidad {
    font-weight: 400;
    color: var(--color-texto-suave);
  }
  .calculadora-dpv input,
  .calculadora-dpv select {
    width: 100%;
    min-height: var(--objetivo-tactil);
    font: inherit;
    font-size: 1.25rem;
    padding: var(--espacio-2);
    border: 2px solid var(--color-borde);
    border-radius: var(--radio);
    background: var(--color-fondo);
    color: var(--color-texto);
  }
  .calculadora-dpv input[aria-invalid='true'] {
    border-color: var(--color-alerta);
  }
  .calculadora-dpv .error {
    color: var(--color-alerta);
    margin: var(--espacio-1) 0 0;
  }
  .calculadora-dpv .resultado {
    display: grid;
    gap: var(--espacio-2);
    margin-block-start: var(--espacio-3);
  }
  .calculadora-dpv .valor {
    font-size: 2rem;
  }
  .calculadora-dpv .fuente {
    display: block;
    color: var(--color-texto-suave);
    margin-block-start: var(--espacio-1);
  }
  .calculadora-dpv .indicacion {
    border-inline-start: 4px solid var(--color-marca);
    padding-inline-start: var(--espacio-2);
  }
  .calculadora-dpv .nivel-bajo,
  .calculadora-dpv .nivel-alto {
    border-inline-start-color: var(--color-alerta);
  }
  .preguntas details {
    border-block-end: 1px solid var(--color-borde);
    padding-block: var(--espacio-2);
  }
  .preguntas summary {
    font-weight: 600;
    min-height: var(--objetivo-tactil);
    display: flex;
    align-items: center;
    cursor: pointer;
  }
  .calculadora-dpv .al-cuaderno p {
    margin-block: var(--espacio-3) 0;
  }
  /* El siguiente paso (HU-E2.7) se ve como acción secundaria: compartir sigue siendo la primera. */
  .calculadora-dpv .boton-cuaderno {
    display: inline-flex;
    align-items: center;
    min-height: var(--objetivo-tactil);
    margin-block-start: var(--espacio-2);
    padding-inline: var(--espacio-3);
    border-radius: var(--radio);
    border: 2px solid var(--color-marca);
    color: var(--color-enlace);
    font-weight: 600;
    text-decoration: none;
  }
  .calculadora-dpv .boton-compartir {
    display: inline-flex;
    align-items: center;
    min-height: var(--objetivo-tactil);
    margin-block-start: var(--espacio-3);
    padding-inline: var(--espacio-3);
    border-radius: var(--radio);
    background: var(--color-marca);
    color: var(--color-marca-texto);
    font-weight: 600;
    text-decoration: none;
  }
  .privacidad {
    font-size: var(--texto-pequeno);
    color: var(--color-texto-suave);
  }
</style>

<style>
  .entrada {
    font-size: 1.125rem;
    color: var(--color-texto-suave);
  }
  .calculadora {
    background: var(--color-superficie);
    border: 1px solid var(--color-borde);
    border-radius: var(--radio);
    padding: var(--espacio-3);
    margin-block: var(--espacio-4);
  }
</style>
