---
/**
 * Layout de todas las páginas públicas. Todo el SEO llega ya calculado desde el contrato
 * (src/lib/seo.ts): esta plantilla solo lo pinta. Sin fuentes externas, sin scripts de terceros.
 */
import '@gestionagro/ui/tokens.css';
import { type Miga, NOMBRE_DEL_SITIO } from '../lib/seo.ts';

interface Props {
  title: string;
  description: string;
  canonical: string;
  indexable: boolean;
  og?: Record<string, string>;
  migas?: Miga[];
  jsonLd?: Record<string, unknown>;
}

const { title, description, canonical, indexable, og = {}, migas = [], jsonLd } = Astro.props;
---
<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!indexable && <meta name="robots" content="noindex" />}
    {Object.entries(og).map(([clave, valor]) => <meta property={`og:${clave}`} content={valor} />)}
    {
      /* «<» escapado: un texto con «</script>» en el contenido no puede cerrar la etiqueta. */
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
        />
      )
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/agro/app/iconos/icono-192.png" />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <header class="cabecera">
      <a class="marca" href="/herramientas/agro/">
        <svg class="marca-hoja" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" fill-rule="evenodd" d="M4.54 4.54A13.44 13.44 0 0 1 19.46 19.46A13.44 13.44 0 0 1 4.54 4.54ZM5.082 4.658L19.342 18.918L18.918 19.342L4.658 5.082Z" /></svg>
        <span>{NOMBRE_DEL_SITIO}</span>
      </a>
    </header>
    {
      migas.length > 0 && (
        <nav aria-label="Migas de pan" class="migas">
          <ol>
            {migas.map((m, i) =>
              i === migas.length - 1 ? (
                <li aria-current="page">{m.nombre}</li>
              ) : (
                <li>
                  <a href={new URL(m.url).pathname}>{m.nombre}</a>
                </li>
              ),
            )}
          </ol>
        </nav>
      )
    }
    <main id="contenido">
      <slot />
    </main>
    <footer class="pie">
      <p><strong>{NOMBRE_DEL_SITIO}</strong> · Tus datos no salen de tu teléfono: las calculadoras funcionan en el navegador.</p>
      <p><a href="/agro/privacidad/">Política de tratamiento de datos</a></p>
    </footer>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    font-family: var(--fuente);
    font-size: var(--texto-base);
    line-height: var(--interlineado);
    color: var(--color-texto);
    background: var(--color-fondo);
  }
  main,
  .migas,
  .pie {
    max-width: var(--ancho-lectura);
    margin-inline: auto;
    padding-inline: var(--espacio-3);
  }
  a {
    color: var(--color-enlace);
  }
  h1 {
    font-size: var(--texto-titulo);
    line-height: 1.2;
  }
  .saltar {
    position: absolute;
    left: -9999px;
  }
  .saltar:focus {
    left: var(--espacio-3);
    top: var(--espacio-3);
    background: var(--color-fondo);
    padding: var(--espacio-2);
  }
  .cabecera {
    background: var(--color-marca);
    padding: var(--espacio-3);
  }
  .marca {
    color: var(--color-marca-texto);
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
    text-decoration: none;
    display: inline-flex;
    gap: var(--espacio-2);
    min-height: var(--objetivo-tactil);
    align-items: center;
  }
  .marca-hoja {
    width: 1.5rem;
    height: 1.5rem;
    flex: none;
  }
  .migas ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-2);
    padding: 0;
    font-size: var(--texto-pequeno);
    color: var(--color-texto-suave);
  }
  .migas li + li::before {
    content: '›';
    margin-inline-end: var(--espacio-2);
  }
  .pie {
    margin-top: var(--espacio-5);
    padding-block: var(--espacio-4);
    border-top: 1px solid var(--color-borde);
    font-size: var(--texto-pequeno);
    color: var(--color-texto-suave);
  }
</style>
