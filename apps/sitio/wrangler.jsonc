// GENERADO por scripts/generar-wrangler.ts desde infrastructure/celdas.json. No editar a mano.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agro-sitio",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "workers_dev": false,
  "routes": [
    {
      "pattern": "agro.laboratorio-digital.com",
      "custom_domain": true
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "EVENTOS",
      "dataset": "agro_eventos"
    }
  ],
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "agro-sitio-staging",
      "workers_dev": true,
      "routes": [],
      "analytics_engine_datasets": [
        {
          "binding": "EVENTOS",
          "dataset": "agro_eventos_staging"
        }
      ]
    }
  }
}
