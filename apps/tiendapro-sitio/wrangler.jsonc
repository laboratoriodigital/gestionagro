// GENERADO por scripts/generar-wrangler.ts desde infrastructure/celdas.json. No editar a mano.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tiendapro-sitio",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "routes": [
    {
      "pattern": "tiendapro.co",
      "custom_domain": true
    },
    {
      "pattern": "www.tiendapro.co",
      "custom_domain": true
    }
  ],
  "env": {
    "staging": {
      "name": "tiendapro-sitio-staging",
      "workers_dev": true,
      "routes": []
    }
  }
}
