---
// La página que no existe (HU-T18.5): dice dónde seguir, con la marca y sin culpas.
import Marco from '../componentes/Marco.astro';
import { MARCA, PANEL } from '../contenido.ts';
---
<Marco titulo={`Esta página no existe · ${MARCA}`} descripcion="La página que buscas no está en TiendaPro." ruta="/404/">
  <section class="legal">
    <h1>Esta página no existe</h1>
    <p class="legal__fecha">Puede que el enlace esté mal escrito o que la página se haya movido.</p>
    <div class="acciones">
      <a class="boton" href="/">Ir al inicio</a>
      <a class="enlace-flecha" href={PANEL} data-panel>Crear mi tienda</a>
    </div>
  </section>
</Marco>
