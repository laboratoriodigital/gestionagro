// GENERADO por scripts/generar-wrangler.ts desde infrastructure/celdas.json. No editar a mano.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tienda-api-c1",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-30",
  "workers_dev": false,
  "vars": {
    "CELDA": "c1",
    "PRODUCTO": "tienda",
    "PLAN": "free",
    "MEDIOS": "img.laboratorio-digital.app",
    "AMBIENTE": "produccion",
    "CORREO_REMITENTE": "avisos@tiendapro.co",
    "RECURSO_MCP_COMERCIO": "https://mcp.tiendapro.co",
    "EMISOR_OAUTH": "https://cuenta.laboratorio-digital.com"
  },
  "services": [
    {
      "binding": "CORE",
      "service": "agro-core",
      "entrypoint": "ServicioDelCore"
    }
  ],
  "d1_databases": [
    {
      "binding": "tienda_c1_s1",
      "database_name": "tienda_c1_s1",
      "migrations_dir": "../../infrastructure/migraciones/tienda"
    },
    {
      "binding": "tienda_control",
      "database_name": "tienda_control",
      "migrations_dir": "../../infrastructure/migraciones/tienda-control"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SITIOS",
      "bucket_name": "tienda-c1"
    },
    {
      "binding": "FOTOS",
      "bucket_name": "tienda-c1-medios"
    }
  ],
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "ratelimits": [
    {
      "name": "LIMITE_COTIZAR",
      "namespace_id": "3001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "LIMITE_AVISAME",
      "namespace_id": "3002",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "LIMITE_PEDIDOS",
      "namespace_id": "3003",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "LIMITE_SEGUIMIENTO",
      "namespace_id": "3004",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "LIMITE_SOLICITUDES",
      "namespace_id": "3005",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "LIMITE_COBROS",
      "namespace_id": "3006",
      "simple": {
        "limit": 3,
        "period": 60
      }
    },
    {
      "name": "LIMITE_AVISOS",
      "namespace_id": "3007",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "LIMITE_MEDICION",
      "namespace_id": "3008",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "LIMITE_MCP",
      "namespace_id": "3009",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "LIMITE_MCP_PEDIDOS",
      "namespace_id": "3010",
      "simple": {
        "limit": 1,
        "period": 60
      }
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "MEDICION",
      "dataset": "tienda_eventos"
    }
  ],
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "tienda-api-c1-staging",
      "workers_dev": false,
      "vars": {
        "CELDA": "c1",
        "PRODUCTO": "tienda",
        "PLAN": "free",
        "MEDIOS": "img--staging.laboratorio-digital.app",
        "AMBIENTE": "staging",
        "CORREO_REMITENTE": "avisos@tiendapro.co",
        "ENSAYOS": "1",
        "RECURSO_MCP_COMERCIO": "https://tienda-panel-staging.laboratoriodigital-la.workers.dev",
        "EMISOR_OAUTH": "https://agro-core-staging.laboratoriodigital-la.workers.dev"
      },
      "services": [
        {
          "binding": "CORE",
          "service": "agro-core-staging",
          "entrypoint": "ServicioDelCore"
        }
      ],
      "d1_databases": [
        {
          "binding": "tienda_c1_s1",
          "database_name": "tienda_c1_s1_staging",
          "migrations_dir": "../../infrastructure/migraciones/tienda"
        },
        {
          "binding": "tienda_control",
          "database_name": "tienda_control_staging",
          "migrations_dir": "../../infrastructure/migraciones/tienda-control"
        }
      ],
      "r2_buckets": [
        {
          "binding": "SITIOS",
          "bucket_name": "tienda-c1-staging"
        },
        {
          "binding": "FOTOS",
          "bucket_name": "tienda-c1-medios-staging"
        }
      ],
      "triggers": {
        "crons": []
      },
      "ratelimits": [
        {
          "name": "LIMITE_COTIZAR",
          "namespace_id": "3101",
          "simple": {
            "limit": 30,
            "period": 60
          }
        },
        {
          "name": "LIMITE_AVISAME",
          "namespace_id": "3102",
          "simple": {
            "limit": 10,
            "period": 60
          }
        },
        {
          "name": "LIMITE_PEDIDOS",
          "namespace_id": "3103",
          "simple": {
            "limit": 10,
            "period": 60
          }
        },
        {
          "name": "LIMITE_SEGUIMIENTO",
          "namespace_id": "3104",
          "simple": {
            "limit": 20,
            "period": 60
          }
        },
        {
          "name": "LIMITE_SOLICITUDES",
          "namespace_id": "3105",
          "simple": {
            "limit": 5,
            "period": 60
          }
        },
        {
          "name": "LIMITE_COBROS",
          "namespace_id": "3106",
          "simple": {
            "limit": 3,
            "period": 60
          }
        },
        {
          "name": "LIMITE_AVISOS",
          "namespace_id": "3107",
          "simple": {
            "limit": 60,
            "period": 60
          }
        },
        {
          "name": "LIMITE_MEDICION",
          "namespace_id": "3108",
          "simple": {
            "limit": 60,
            "period": 60
          }
        },
        {
          "name": "LIMITE_MCP",
          "namespace_id": "3109",
          "simple": {
            "limit": 60,
            "period": 60
          }
        },
        {
          "name": "LIMITE_MCP_PEDIDOS",
          "namespace_id": "3110",
          "simple": {
            "limit": 1,
            "period": 60
          }
        }
      ],
      "analytics_engine_datasets": [
        {
          "binding": "MEDICION",
          "dataset": "tienda_eventos_staging"
        }
      ]
    }
  }
}
