                }
              }
            }
          },
          "404": {
            "description": "La tienda o lo pedido no existe.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Respuesta"
                }
              }
            }
          },
          "422": {
            "description": "El cuerpo no cumple el esquema o falta algo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Respuesta"
                }
              }
            }
          },
          "429": {
            "description": "Pasó el límite: 20 por minuto por IP.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Respuesta"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "503": {
            "description": "La tienda está en pausa unos minutos: se puede leer, no escribir.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Respuesta"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/avisame": {
      "post": {
        "operationId": "avisame",
        "summary": "Avísame cuando haya",
        "description": "Suma una persona interesada en una combinación agotada. No guarda ningún dato de quien lo pide. Límite: 10 por minuto por IP.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "variante": {
                    "type": "string",
