                }
              }
            }
          }
        }
      }
    },
    "/api/v1/solicitudes/seguimiento": {
      "post": {
        "operationId": "seguimientoDeSolicitud",
        "summary": "Seguir una solicitud",
        "description": "En qué va una solicitud y su respuesta, con su radicado y su secreto. Límite: 20 por minuto por IP.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "radicado": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "secreto": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{22}$"
                  }
                },
                "required": [
                  "radicado",
                  "secreto"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Hecho.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Respuesta"
                }
              }
            }
          },
          "404": {
            "description": "La tienda o lo pedido no existe.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Respuesta"
                }
              }
            }
          },
          "422": {
            "description": "El cuerpo no cumple el esquema o falta algo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Respuesta"
                }
              }
            }
          },
          "429": {
            "description": "Pasó el límite: 20 por minuto por IP.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Respuesta"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "503": {
            "description": "La tienda está en pausa unos minutos: se puede leer, no escribir.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Respuesta"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Respuesta": {
        "type": "object",
        "description": "Toda respuesta trae `estado`, que dice qué pasó, y, si algo no salió, `motivo`, en palabras para la persona.",
        "properties": {
          "estado": {
            "type": "string"
          },
          "motivo": {
            "type": "string"
          }
        },
        "required": [
          "estado"
        ]
      }
    }
  }
}
