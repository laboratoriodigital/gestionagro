    "/api/v1/solicitudes": {
      "post": {
        "operationId": "radicarSolicitud",
        "summary": "Radicar una solicitud",
        "description": "Una petición, queja, reclamo, retracto, garantía o solicitud sobre los datos personales, con su radicado y la fecha. Límite: 5 por minuto por IP.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "tipo": {
                    "type": "string",
                    "enum": [
                      "peticion",
                      "queja",
                      "reclamo",
                      "retracto",
                      "reversion",
                      "datos_consulta",
                      "datos_reclamo"
                    ]
                  },
                  "pedido": {
                    "type": "string",
                    "pattern": "^[0-9A-HJKMNP-TV-Z]{6}$"
                  },
                  "texto": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 2000
                  },
                  "contacto": {
                    "type": "string",
                    "minLength": 5,
                    "maxLength": 120
                  },
                  "acepta": {
                    "type": "boolean",
                    "const": true
                  },
                  "seguimiento": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{22}$"
                  }
                },
                "required": [
                  "tipo",
                  "texto",
                  "contacto",
                  "acepta",
                  "seguimiento"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Hecho.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Respuesta"
                }
              }
            }
          },
          "404": {
            "description": "La tienda o lo pedido no existe.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Respuesta"
                }
              }
            }
          },
          "422": {
            "description": "El cuerpo no cumple el esquema o falta algo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Respuesta"
                }
              }
            }
          },
          "429": {
            "description": "Pasó el límite: 5 por minuto por IP.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Respuesta"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "503": {
            "description": "La tienda está en pausa unos minutos: se puede leer, no escribir.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Respuesta"
                }
              }
            },
            "headers": {
