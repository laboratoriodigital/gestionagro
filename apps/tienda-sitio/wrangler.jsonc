// GENERADO por scripts/generar-wrangler.ts desde infrastructure/celdas.json. No editar a mano.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tienda-sitio",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-30",
  "workers_dev": false,
  "routes": [],
  "services": [
    {
      "binding": "API_C1",
      "service": "tienda-api-c1"
    }
  ],
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "tienda-sitio-staging",
      "workers_dev": true,
      "routes": [
        {
          "pattern": "ensayo-uno--staging.laboratorio-digital.app",
          "custom_domain": true
        },
        {
          "pattern": "ensayo-dos--staging.laboratorio-digital.app",
          "custom_domain": true
        }
      ],
      "services": [
        {
          "binding": "API_C1",
          "service": "tienda-api-c1-staging"
        }
      ]
    }
  }
}
