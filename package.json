{
  "name": "gestionagro",
  "version": "0.1.0",
  "private": true,
  "description": "CultivoPro: calculadoras agronómicas gratuitas y cuaderno de campo offline-first (ED1 Agro).",
  "type": "module",
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "lint": "biome check --error-on-warnings .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/cuaderno/tsconfig.sw.json",
    "test": "vitest run",
    "test:cobertura": "vitest run --coverage",
    "build": "pnpm -r --if-present run build",
    "verificar": "node scripts/verificar.ts",
    "validar:productos": "node scripts/validar-productos.ts",
    "licencias": "node scripts/licencias.ts",
    "e2e": "playwright test --project=telefono-360 && playwright test --project=rendimiento --no-deps --workers=1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.14",
    "@gestionagro/agro-schema": "workspace:*",
    "@gestionagro/d1": "workspace:*",
    "@gestionagro/sync": "workspace:*",
    "@gestionagro/tokens": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.2",
    "ajv": "^8.20.0",
    "fake-indexeddb": "^6.2.5",
    "pdf-lib": "^1.17.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1"
  }
}
